{
  "name": "ai-pptify",
  "version": "0.1.5",
  "type": "module",
  "description": "AI 驱动的 Slidev 演示创作工具 - 支持多种演示类型、AI 辅助创作",
  "keywords": [
    "presentation",
    "slides",
    "slidev",
    "ai",
    "content-creation",
    "技术分享",
    "商业路演",
    "演示文稿",
    "ppt"
  ],
  "author": "Pptify Team",
  "license": "MIT",
  "main": "dist/cli.js",
  "bin": {
    "pptify": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.0.0",
    "@slidev/cli": "^0.49.0",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "marked": "^16.4.1",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "playwright-chromium": "^1.40.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "playwright-chromium": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wordflowlab/pptify.git"
  },
  "homepage": "https://github.com/wordflowlab/pptify#readme",
  "bugs": {
    "url": "https://github.com/wordflowlab/pptify/issues"
  }
}
